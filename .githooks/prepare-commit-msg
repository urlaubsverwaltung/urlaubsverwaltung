#!/usr/bin/env bash

COMMIT_MSG_FILE=$1
# source of the message, "commit" for --amend, -c and -C. the message of an existing commit is kept as it is
COMMIT_SOURCE=$2

if [ "$COMMIT_SOURCE" = "commit" ]; then
  exit 0
fi

# Extract the current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Identify the issue number from the branch name
ISSUE_NUMBER=$(echo "$BRANCH_NAME" | grep -oE '[0-9]+' | head -n 1)

if [ -z "$ISSUE_NUMBER" ]; then
  exit 0
fi

# Append the issue reference unless the message references the issue already
if ! grep -qiE "^closes #$ISSUE_NUMBER\$" "$COMMIT_MSG_FILE"; then
  COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
  printf '%s\n\ncloses #%s\n' "$COMMIT_MSG" "$ISSUE_NUMBER" > "$COMMIT_MSG_FILE"
fi
