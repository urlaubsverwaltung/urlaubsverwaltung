    <addForeignKeyConstraint baseTableName="account" baseColumnNames="person_id"
                             constraintName="fk_account_person"
                             referencedTableName="person" referencedColumnNames="id"
                             onDelete="CASCADE" onUpdate="NO ACTION"/>

